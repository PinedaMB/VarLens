WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

root = { SOI ~ xdebug_header? ~ value ~ EOI }

xdebug_header = @{ ("/" | (ASCII_ALPHA ~ ":")) ~ (!("\r" | "\n") ~ ANY)* ~ ("\r" | "\n")+ }

value = {
    reference? ~ (
        null_val
        | bool_val
        | float_val
        | int_val
        | string_val
        | array_val
        | object_val
        | resource_val
        | recursion_val
        | uninitialized_val
        | printr_array
        | printr_object
        | varexport_object
        | varexport_array
    )
}

reference = { "&" }

null_val = { "NULL" }

bool_val = { "bool(" ~ bool_lit ~ ")" }
bool_lit = { "true" | "false" }

int_val = { "int(" ~ int_lit ~ ")" }
int_lit = @{ ("+" | "-")? ~ ASCII_DIGIT+ }

float_val = { ("float(" | "double(") ~ float_lit ~ ")" }
float_lit = @{
    ("+" | "-")? ~ (
        ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)?
        | "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)?
        | ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)?
    )
    | ("+" | "-")? ~ "INF"
    | "NAN"
}

string_val = { "string(" ~ length ~ ")" ~ quoted_string }
length = @{ ASCII_DIGIT+ }
quoted_string = ${ "\"" ~ inner_string ~ "\"" }
inner_string = @{ ( "\\\"" | "\\\\" | (!"\"" ~ ANY) )* }

array_val = { "array(" ~ length ~ ") {" ~ array_entry* ~ "}" }
array_entry = { "[" ~ key ~ "]=>" ~ value }

object_val = { "object(" ~ class_name ~ ")#" ~ object_id ~ ("(" ~ length ~ ")")? ~ "{" ~ object_entry* ~ "}" }
class_name = @{ (ASCII_ALPHANUMERIC | "_" | "\\" | "@" | "$")+ }
object_id = @{ ASCII_DIGIT+ }
object_entry = { "[" ~ object_key ~ "]=>" ~ value }

object_key = {
    quoted_key ~ (":" ~ (quoted_key | class_name))? ~ (":" ~ visibility)?
    | int_lit
    | identifier
}

visibility = { "public" | "protected" | "private" }
quoted_key = ${ "\"" ~ inner_key ~ "\"" }
inner_key = @{ ( "\\\"" | "\\\\" | (!"\"" ~ ANY) )* }
identifier = @{ (ASCII_ALPHANUMERIC | "_" | "-" | ".")+ }

key = {
    quoted_key
    | int_lit
    | identifier
}

resource_val = { "resource(" ~ ASCII_DIGIT+ ~ ") of type (" ~ (!")" ~ ANY)+ ~ ")" }
recursion_val = { "*RECURSION*" }
uninitialized_val = { "uninitialized(" ~ (!")" ~ ANY)+ ~ ")" }

// Support for PHP print_r / Array raw format
printr_array = { ^"Array" ~ "(" ~ printr_entry+ ~ ")" }
printr_object = { class_name ~ ^"Object" ~ "(" ~ printr_entry* ~ ")" }
printr_entry = { "[" ~ object_key ~ "]" ~ "=>" ~ NEWLINE* ~ (printr_array | printr_object | printr_scalar) }
printr_scalar = @{ !("[" | ")" | "\r" | "\n") ~ (!("\r" | "\n") ~ ANY)* }

// Support for PHP var_export / raw PHP array literals (`array(...)` or `[...]`)
php_prefix = _{ ("<?php" | "<?")? ~ ^"return"? }
varexport_array = {
    php_prefix? ~ ((^"array" ~ "(" ~ varexport_entries? ~ ")") | ("[" ~ varexport_entries? ~ "]")) ~ ";"?
}
varexport_object = {
    php_prefix? ~ (
        (class_name ~ "::" ~ "__set_state" ~ "(" ~ varexport_array ~ ")")
        | ("(" ~ ^"object" ~ ")" ~ varexport_array)
        | ("stdClass::__set_state" ~ "(" ~ varexport_array ~ ")")
    ) ~ ";"?
}
varexport_entries = { varexport_entry ~ ("," ~ varexport_entry)* ~ ","? }
varexport_entry = { (varexport_key ~ "=>" ~ varexport_val) | varexport_val }
varexport_key = { sq_string | quoted_key | int_lit | identifier }
varexport_val = {
    varexport_object
    | varexport_array
    | null_lit
    | bool_lit
    | float_raw
    | int_lit
    | sq_string
    | quoted_string
    | identifier
}
null_lit = { ^"null" }
float_raw = @{
    ("+" | "-")? ~ (
        ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)?
        | "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)?
        | ASCII_DIGIT+ ~ ("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+
    )
}
sq_string = ${ "'" ~ inner_sq_string ~ "'" }
inner_sq_string = @{ ( "\\'" | "\\\\" | (!"'" ~ ANY) )* }
